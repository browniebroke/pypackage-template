[tox]
isolated_build = true
requires =
    tox>=4.2
env_list =
    py314-django{60,52}
    py313-django{60,52}
    py312-django{60,52}
    py311-django{52}
    py310-django{52}

[testenv]
runner = uv-venv-lock-runner
set_env =
    PYTHONDONTWRITEBYTECODE=1
dependency_groups =
    dev
deps =
    django60: django60
    django52: django52
commands =
    python \
      -m coverage run \
      -m pytest {posargs:tests}
